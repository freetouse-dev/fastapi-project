APP_NAME=Unitask
APP_VERSION=0.1.0
APP_DESCRIPTION=Unitask - A modern collaborative multi-tenant project management platform.

ENVIRONMENT=development
DEBUG=True

# Database Configuration (Switch between "mysql" and "postgresql" seamlessly)
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_USER=ajay
DB_PASSWORD="YOUR_PASSWORD"
DB_NAME="YOUR_DATABASE_NAME"

SECRET_KEY="YOUR_SECRET_KEY"
ALGORITHM="YOUR_ALGORITHM"
ACCESS_TOKEN_EXPIRE_MINUTES=30

smtp_host=smtp.gmail.com
smtp_port=587
smtp_user="YOUR_EMAIL_ADDRESS"
smtp_password="YOUR_EMAIL_PASSWORD"
smtp_tls=True
emails_from_email="YOUR_EMAIL_ADDRESS"